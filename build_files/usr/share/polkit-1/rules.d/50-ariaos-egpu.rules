// AriaOS: autorizza il gruppo wheel a gestire lo stato on-demand della eGPU.
// Il privilegio passwordless copre esclusivamente ariaos-egpu.service,
// mai un comando estensibile. Vale solo per sessioni locali attive:
// via SSH polkit richiedera' comunque l'autenticazione admin.
polkit.addRule(function(action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") == "ariaos-egpu.service" &&
      ["start", "stop", "restart"].indexOf(action.lookup("verb")) >= 0 &&
      subject.user != "root" &&
      subject.isInGroup("wheel") &&
      subject.active &&
      subject.local) {
    return polkit.Result.YES;
  }
});
