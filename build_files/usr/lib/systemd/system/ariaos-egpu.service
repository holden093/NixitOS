# AriaOS: stato on-demand della eGPU NVIDIA (compute-only).
# Non abilitata: viene avviata manualmente tramite polkit quando serve la eGPU.
[Unit]
Description=AriaOS NVIDIA eGPU compute state
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/ariaos-egpu up
ExecStop=/usr/libexec/ariaos-egpu down

[Install]
WantedBy=multi-user.target
