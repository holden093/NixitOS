#!/usr/bin/env bash
set -Eeuo pipefail

SNAPSHOT=/var/home-backup
MOUNT_POINT=
TEMP_MOUNT=0
BACKUP_FILE=
PARTIAL_FILE=

cleanup() {
  local status=$?
  trap - EXIT INT TERM

  if btrfs subvolume show "$SNAPSHOT" >/dev/null 2>&1; then
    btrfs subvolume delete "$SNAPSHOT" >/dev/null 2>&1 || true
  fi
  if (( TEMP_MOUNT == 1 )) && mountpoint -q "$MOUNT_POINT"; then
    umount "$MOUNT_POINT" || true
  fi
  if (( TEMP_MOUNT == 1 )) && [[ -n "$MOUNT_POINT" ]]; then
    rmdir "$MOUNT_POINT" 2>/dev/null || true
  fi
  if [[ -n "$PARTIAL_FILE" && -f "$PARTIAL_FILE" ]]; then
    rm -f -- "$PARTIAL_FILE"
  fi
  exit "$status"
}
trap cleanup EXIT INT TERM

if (( EUID != 0 )); then
  echo "❌ Errore: questo script deve essere eseguito come root o con sudo."
  exit 1
fi

for cmd in btrfs dialog zstd pv lsblk mount mountpoint umount; do
  command -v "$cmd" >/dev/null || {
    echo "Errore: comando richiesto '$cmd' non trovato."
    exit 1
  }
done

if ! btrfs subvolume show /var/home >/dev/null 2>&1; then
  dialog --msgbox "Errore: /var/home non risulta essere un subvolume Btrfs valido." 8 60
  exit 1
fi

partitions=$(lsblk -rn -o NAME,FSTYPE,MOUNTPOINT,SIZE | awk \
  '$2 != "" && $2 != "swap" && $2 != "vfat" && $2 != "efi" && $3 != "/" && $3 != "/boot" && $3 != "/var" && $3 != "[SWAP]" {print $1, $2, $4, $3}')
if [[ -z "$partitions" ]]; then
  dialog --msgbox "Nessuna partizione esterna valida trovata.\nCollega un disco USB e riprova." 8 60
  exit 1
fi

menu_options=()
while read -r name fstype size mountpoint_path; do
  desc="$fstype - $size"
  [[ -n "$mountpoint_path" ]] && desc+=" (Montato in $mountpoint_path)" || desc+=" (Non montato)"
  menu_options+=("/dev/$name" "$desc")
done <<< "$partitions"

if ! TARGET_DEV=$(dialog --clear --title "AriaOS - Backup Home" \
  --menu "Scegli la partizione di destinazione:" 15 70 6 \
  "${menu_options[@]}" 3>&1 1>&2 2>&3); then
  clear
  echo "Operazione annullata."
  exit 0
fi

MOUNT_POINT=$(lsblk -nr -o MOUNTPOINT "$TARGET_DEV" | head -n 1)
if [[ -z "$MOUNT_POINT" ]]; then
  MOUNT_POINT=$(mktemp -d /tmp/ariaos-backup-mnt.XXXXXX)
  mount "$TARGET_DEV" "$MOUNT_POINT"
  TEMP_MOUNT=1
fi

BACKUP_FILE="$MOUNT_POINT/ariaos_home.btrfs.zst"
PARTIAL_FILE="$BACKUP_FILE.partial.$$"
if [[ -e "$BACKUP_FILE" ]] && ! dialog --yesno \
  "Il file $BACKUP_FILE esiste già.\nVuoi sovrascriverlo?" 8 60; then
  clear
  echo "Operazione annullata."
  BACKUP_FILE=
  PARTIAL_FILE=
  exit 0
fi

if btrfs subvolume show "$SNAPSHOT" >/dev/null 2>&1; then
  btrfs subvolume delete "$SNAPSHOT" >/dev/null
fi
dialog --infobox "Creazione snapshot read-only in corso..." 5 50
btrfs subvolume snapshot -r /var/home "$SNAPSHOT" >/dev/null

estimated_size=$(du -s -B1 "$SNAPSHOT" | awk '{print $1}')
if ! (btrfs send "$SNAPSHOT" | pv -n -s "$estimated_size" | zstd -f -T0 -o "$PARTIAL_FILE") \
  2>&1 | dialog --backtitle "AriaOS - Backup" --title "Esportazione" \
  --gauge "Compressione e salvataggio in corso...\nDestinazione: $BACKUP_FILE" 10 70; then
  dialog --title "Errore" --msgbox \
    "Backup fallito. Il file parziale verrà rimosso." 8 60
  exit 1
fi

[[ -s "$PARTIAL_FILE" ]] || {
  dialog --title "Errore" --msgbox "Il file di backup è vuoto." 8 50
  exit 1
}
mv -f -- "$PARTIAL_FILE" "$BACKUP_FILE"
PARTIAL_FILE=

dialog --title "Completato" --msgbox \
  "Backup completato con successo.\nFile: $BACKUP_FILE" 8 70
clear
