#!/usr/bin/env bash
set -Eeuo pipefail

# AriaOS llama-vm
# Gestisce la macchina virtuale dedicata all'inferenza (endpoint OpenAI locale).
# La eGPU NVIDIA e' riservata a vfio-pci dall'host e passa per intero alla VM:
# l'host non carica mai driver NVIDIA. Uso: llama-vm on|off|status.

readonly DOMAIN=${LLAMA_VM_DOMAIN:-llama-vm}
readonly PORT=${LLAMA_VM_PORT:-8080}
readonly SYSFS=${LLAMA_VM_SYSFS:-/sys}
readonly VIRSH=${LLAMA_VM_VIRSH:-virsh}
readonly LSPCI=${LLAMA_VM_LSPCI:-lspci}
readonly CURL=${LLAMA_VM_CURL:-curl}
readonly DISK=${LLAMA_VM_DISK:-/var/vms/llama/llama.qcow2}
readonly MODELS=${LLAMA_VM_MODELS:-/var/vms/models}
readonly GPU_ID=10de:2504
readonly AUDIO_ID=10de:228e
readonly ENDPOINT="127.0.0.1:${PORT}"

die() {
  echo "❌ $*" >&2
  exit 1
}

require_root() {
  if [ "$EUID" -ne 0 ]; then
    die "Questo script deve essere eseguito come root o con sudo."
  fi
}

usage() {
  echo "Uso: llama-vm on|off|status" >&2
  exit 1
}

bdf_of() {
  # $1 = vendor:device; restituisce il primo BDF (dom:bus:slt.fn) rilevato.
  "$LSPCI" -D -n -d "$1" | awk '{print $1}' | head -n1
}

vfio_state() {
  # $1 = BDF; stampa il driver bindato oppure "(nessuno)".
  local device=$SYSFS/bus/pci/devices/$1
  if [[ ! -d $device ]]; then
    printf '%s\n' "device non presente"
    return 1
  fi
  if [[ -e $device/driver ]]; then
    basename "$(readlink -f "$device/driver")"
  else
    printf '%s\n' "nessun driver"
  fi
}

render_domain() {
  # $1 = file xml, $2 = BDF GPU, $3 = BDF audio
  local xml=$1 gpu=$2 audio=$3
  local -a gpu_addr audio_addr
  IFS=':.' read -r -a gpu_addr <<< "$gpu"
  IFS=':.' read -r -a audio_addr <<< "$audio"
  cat > "$xml" <<EOF
<domain type='kvm'>
  <name>${DOMAIN}</name>
  <memory unit='KiB'>4194304</memory>
  <currentMemory unit='KiB'>4194304</currentMemory>
  <vcpu placement='static'>2</vcpu>
  <os>
    <type arch='x86_64' machine='pc-q35-7.2'>hvm</type>
    <firmware>efi</firmware>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <cpu mode='host-passthrough' check='none'/>
  <memoryBacking>
    <source type='memfd'/>
    <access mode='shared'/>
  </memoryBacking>
  <clock offset='utc'/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='${DISK}'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <controller type='pci' index='0' model='pcie-root'/>
    <interface type='user'>
      <port protocol='tcp' address='127.0.0.1' port='${PORT}' to='${PORT}'/>
    </interface>
    <filesystem type='mount' accessmode='passthrough'>
      <driver type='virtiofs'/>
      <source dir='${MODELS}'/>
      <target dir='/models'/>
      <readonly/>
    </filesystem>
    <serial type='pty'>
      <target type='isa-serial' port='0'/>
    </serial>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
    <video>
      <model type='none'/>
    </video>
    <rng model='virtio'>
      <backend model='random'>/dev/urandom</backend>
    </rng>
    <hostdev mode='subsystem' type='pci' managed='yes'>
      <source>
        <address domain='0x${gpu_addr[0]}' bus='0x${gpu_addr[1]}' slot='0x${gpu_addr[2]}' function='0x${gpu_addr[3]}'/>
      </source>
    </hostdev>
    <hostdev mode='subsystem' type='pci' managed='yes'>
      <source>
        <address domain='0x${audio_addr[0]}' bus='0x${audio_addr[1]}' slot='0x${audio_addr[2]}' function='0x${audio_addr[3]}'/>
      </source>
    </hostdev>
  </devices>
</domain>
EOF
}

wait_for_endpoint() {
  local attempt
  echo "==> Attesa endpoint OpenAI su ${ENDPOINT}..."
  for attempt in $(seq 1 60); do
    if "$CURL" -fsS "http://${ENDPOINT}/v1/models" >/dev/null 2>&1; then
      echo "✅ Endpoint pronto: http://${ENDPOINT}/v1"
      return 0
    fi
    sleep 1
  done
  die "L'endpoint non risponde dopo 60 secondi."
}

cmd_on() {
  [[ -f $DISK ]] || die "Disco VM mancante (${DISK}). Esegui guest/install-vm.sh dal repository."
  [[ -d $MODELS ]] || die "Directory modelli mancante (${MODELS})."

  echo "==> Rilevamento eGPU NVIDIA sul bus PCIe..."
  local gpu_bdf audio_bdf
  gpu_bdf=$(bdf_of "$GPU_ID")
  audio_bdf=$(bdf_of "$AUDIO_ID")
  [[ -n $gpu_bdf ]] || die "eGPU NVIDIA non rilevata. Verifica l'enclosure e autorizza con boltctl."
  [[ -n $audio_bdf ]] || die "Funzione audio NVIDIA non rilevata (${AUDIO_ID})."
  echo "    GPU: http://${ENDPOINT}  ${gpu_bdf}"
  echo "    Audio: ${audio_bdf}"

  echo "==> Verifica riserva vfio-pci..."
  local gpu_driver audio_driver
  gpu_driver=$(vfio_state "$gpu_bdf")
  audio_driver=$(vfio_state "$audio_bdf")
  [[ $gpu_driver == vfio-pci ]] || die "GPU ${gpu_bdf} usa il driver '${gpu_driver}': la scheda deve restare riservata a vfio-pci."
  [[ $audio_driver == vfio-pci ]] || die "Audio ${audio_bdf} usa il driver '${audio_driver}' (atteso vfio-pci)."
  echo "    Entrambe le funzioni sono in vfio-pci."

  local state
  state=$("$VIRSH" -c qemu:///system domstate "$DOMAIN" 2>/dev/null || true)
  case "$state" in
    running)
      echo "==> VM già attiva."
      wait_for_endpoint
      ;;
    paused)
      die "VM pausata: esegui 'llama-vm off' e poi 'llama-vm on'."
      ;;
    *)
      echo "==> Configurazione dominio con BDF attuali..."
      local xml
      xml=$(mktemp /tmp/llama-vm.XXXXXX.xml)
      trap 'rm -f "${xml:-}"' EXIT
      "$VIRSH" -c qemu:///system undefine --managed-save "$DOMAIN" >/dev/null 2>&1 || true
      render_domain "$xml" "$gpu_bdf" "$audio_bdf"
      "$VIRSH" -c qemu:///system define "$xml" >/dev/null
      echo "==> Avvio ${DOMAIN}..."
      "$VIRSH" -c qemu:///system start "$DOMAIN" >/dev/null
      wait_for_endpoint
      ;;
  esac
}

cmd_off() {
  local state
  state=$("$VIRSH" -c qemu:///system domstate "$DOMAIN" 2>/dev/null || true)
  if [[ $state != running ]]; then
    echo "✅ VM ${DOMAIN} non è attiva. Puoi scollegare la eGPU."
    return 0
  fi
  echo "==> Spegnimento ${DOMAIN}..."
  "$VIRSH" -c qemu:///system shutdown "$DOMAIN" >/dev/null
  local attempt
  for attempt in $(seq 1 60); do
    state=$("$VIRSH" -c qemu:///system domstate "$DOMAIN" 2>/dev/null || true)
    [[ $state == "shut off" ]] && break
    sleep 1
  done
  [[ $state == "shut off" ]] || die "La VM non si è spenta: NON scollegare la eGPU."
  echo "✅ VM spenta. Ora puoi scollegare il cavo Thunderbolt."
}

cmd_status() {
  echo "==> Stato eGPU (vfio-pci):"
  local gpu_bdf audio_bdf gpu_driver audio_driver
  gpu_bdf=$(bdf_of "$GPU_ID" || true)
  audio_bdf=$(bdf_of "$AUDIO_ID" || true)
  if [[ -n $gpu_bdf ]]; then
    gpu_driver=$(vfio_state "$gpu_bdf" 2>/dev/null || echo "n/d")
    echo "    GPU ${gpu_bdf}: ${gpu_driver}"
  else
    echo "    GPU: eGPU non rilevata (enclosure spenta o non autorizzata)"
  fi
  if [[ -n $audio_bdf ]]; then
    audio_driver=$(vfio_state "$audio_bdf" 2>/dev/null || echo "n/d")
    echo "    Audio ${audio_bdf}: ${audio_driver}"
  fi
  echo "==> Stato VM ${DOMAIN}:"
  "$VIRSH" -c qemu:///system domstate "$DOMAIN"
  echo "==> Endpoint OpenAI:"
  if "$CURL" -fsS "http://${ENDPOINT}/v1/models" >/dev/null 2>&1; then
    echo "    http://${ENDPOINT}/v1 (attivo)"
  else
    echo "    http://${ENDPOINT}/v1 (non raggiungibile)"
  fi
}

require_root
case "${1:-}" in
  on) cmd_on ;;
  off) cmd_off ;;
  status) cmd_status ;;
  *) usage ;;
esac
