#!/usr/bin/env bash
set -Eeuo pipefail

RECEIVED=/var/home-backup
RESTORED=/var/home-restored
MOUNT_POINT=
TEMP_MOUNT=0
ACTIVATED=0

cleanup() {
  local status=$?
  trap - EXIT INT TERM
  if (( ACTIVATED == 0 )); then
    btrfs subvolume delete "$RESTORED" >/dev/null 2>&1 || true
  fi
  btrfs subvolume delete "$RECEIVED" >/dev/null 2>&1 || true
  if (( TEMP_MOUNT == 1 )) && mountpoint -q "$MOUNT_POINT"; then
    umount "$MOUNT_POINT" || true
  fi
  if (( TEMP_MOUNT == 1 )) && [[ -n "$MOUNT_POINT" ]]; then
    rmdir "$MOUNT_POINT" 2>/dev/null || true
  fi
  exit "$status"
}
trap cleanup EXIT INT TERM

if (( EUID != 0 )); then
  echo "❌ Errore: questo script deve essere eseguito come root o con sudo."
  exit 1
fi

for cmd in btrfs dialog zstdcat pv lsblk mount mountpoint umount stat; do
  command -v "$cmd" >/dev/null || {
    echo "Errore: comando richiesto '$cmd' non trovato."
    exit 1
  }
done

partitions=$(lsblk -rn -o NAME,FSTYPE,MOUNTPOINT,SIZE | awk \
  '$2 != "" && $2 != "swap" && $2 != "vfat" && $2 != "efi" && $3 != "/" && $3 != "/boot" && $3 != "/var" && $3 != "[SWAP]" {print $1, $2, $4, $3}')
if [[ -z "$partitions" ]]; then
  dialog --msgbox "Nessuna partizione esterna valida trovata." 8 60
  exit 1
fi

menu_options=()
while read -r name fstype size mountpoint_path; do
  desc="$fstype - $size"
  [[ -n "$mountpoint_path" ]] && desc+=" (Montato in $mountpoint_path)" || desc+=" (Non montato)"
  menu_options+=("/dev/$name" "$desc")
done <<< "$partitions"

if ! TARGET_DEV=$(dialog --clear --title "AriaOS - Restore Home" \
  --menu "Scegli la partizione contenente il backup:" 15 70 6 \
  "${menu_options[@]}" 3>&1 1>&2 2>&3); then
  clear
  echo "Operazione annullata."
  exit 0
fi

MOUNT_POINT=$(lsblk -nr -o MOUNTPOINT "$TARGET_DEV" | head -n 1)
if [[ -z "$MOUNT_POINT" ]]; then
  MOUNT_POINT=$(mktemp -d /tmp/ariaos-restore-mnt.XXXXXX)
  mount "$TARGET_DEV" "$MOUNT_POINT"
  TEMP_MOUNT=1
fi

BACKUP_FILE="$MOUNT_POINT/ariaos_home.btrfs.zst"
if [[ ! -s "$BACKUP_FILE" ]]; then
  dialog --msgbox "Backup non trovato o vuoto:\n$BACKUP_FILE" 8 70
  exit 1
fi

if ! dialog --yesno \
  "ATTENZIONE!\nLa home corrente verrà sostituita. Una copia verrà conservata in /var/home.old_TIMESTAMP.\n\nProcedere?" \
  11 70; then
  clear
  echo "Operazione annullata."
  exit 0
fi

for path in "$RECEIVED" "$RESTORED"; do
  if btrfs subvolume show "$path" >/dev/null 2>&1; then
    btrfs subvolume delete "$path" >/dev/null
  elif [[ -e "$path" ]]; then
    dialog --title "Errore" --msgbox "$path esiste ma non è un subvolume gestibile." 8 70
    exit 1
  fi
done

file_size=$(stat -c%s "$BACKUP_FILE")
if ! (pv -n -s "$file_size" "$BACKUP_FILE" | zstdcat | btrfs receive /var/) \
  2>&1 | dialog --backtitle "AriaOS - Restore" --title "Importazione" \
  --gauge "Verifica e ricezione dello stream Btrfs..." 10 70; then
  dialog --title "Errore" --msgbox "Stream non valido o ricezione Btrfs fallita." 8 60
  exit 1
fi

if ! btrfs subvolume show "$RECEIVED" >/dev/null 2>&1; then
  dialog --title "Errore" --msgbox "Il backup non contiene il subvolume atteso home-backup." 8 70
  exit 1
fi

btrfs subvolume snapshot "$RECEIVED" "$RESTORED" >/dev/null
btrfs subvolume show "$RESTORED" >/dev/null

old_home="/var/home.old_$(date +%s)"
if ! mv /var/home "$old_home"; then
  dialog --title "Errore" --msgbox "Impossibile preservare la home corrente; nessun dato è stato sostituito." 8 70
  exit 1
fi
if ! mv "$RESTORED" /var/home; then
  mv "$old_home" /var/home || true
  dialog --title "Errore critico" --msgbox "Attivazione fallita. È stato tentato il rollback della home originale." 9 70
  exit 1
fi
ACTIVATED=1

dialog --title "Completato" --msgbox \
  "Ripristino completato.\nHome precedente: $old_home\n\nRiavviare prima del login grafico." 10 70
clear
