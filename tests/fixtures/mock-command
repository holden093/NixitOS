#!/usr/bin/env bash
set -Eeuo pipefail

command_name=${0##*/}
printf '%s %s\n' "$command_name" "$*" >> "${ARIAOS_TEST_LOG:?}"

case "$command_name" in
  btrfs)
    case "${1:-} ${2:-}" in
      "subvolume show")
        case "${3:-}" in
          /var/home|/var/home-backup|/var/home-restored) exit 0 ;;
          *) exit 1 ;;
        esac
        ;;
      "send /var/home-backup") printf 'stream' ;;
      "receive /var/") cat >/dev/null; [[ ${ARIAOS_TEST_SCENARIO:-} != restore_invalid ]] ;;
    esac
    ;;
  clear|mount|umount|mountpoint|nvidia-modprobe|udevadm|sleep|kill)
    exit 0
    ;;
  curl)
    if [[ -e ${ARIAOS_TEST_STATE:?}/curl-ok ]]; then
      exit 0
    fi
    exit 1
    ;;
  date)
    printf '1700000000\n'
    ;;
  dialog)
    case " $* " in
      *" --menu "*) printf '/dev/sdz1\n' ;;
      *" --gauge "*) cat >/dev/null ;;
    esac
    ;;
  du)
    printf '4096 /var/home-backup\n'
    ;;
  ls)
    exit 1
    ;;
  lsblk)
    if [[ $* == *MOUNTPOINT* && $* != *FSTYPE* ]]; then
      printf '%s\n' "${ARIAOS_TEST_MOUNT:?}"
    else
      printf 'sdz1 ext4 %s 64G\n' "${ARIAOS_TEST_MOUNT:?}"
    fi
    ;;
  lsmod)
    cat "${ARIAOS_TEST_STATE:?}/modules" 2>/dev/null || true
    ;;
  lsof)
    if [[ -n ${ARIAOS_TEST_LSOF_PIDS:-} ]]; then
      printf '%s\n' "$ARIAOS_TEST_LSOF_PIDS"
    fi
    ;;
  lspci)
    case " $* " in
      *" 10de:2504 "*) printf '0000:06:00.0 VGA compatible controller: NVIDIA test GPU\n' ;;
      *" 10de:228e "*) printf '0000:06:00.1 Audio device: NVIDIA test audio\n' ;;
      *) exit 0 ;;
    esac
    ;;
  modprobe)
    case " ${1:-} ${2:-} " in
      " -r nvidia_uvm ")
        sed -i '/^nvidia_uvm$/d' "${ARIAOS_TEST_STATE:?}/modules"
        ;;
      " -r nvidia ")
        if [[ ${ARIAOS_TEST_SCENARIO:-} != egpu_no_unload ]]; then
          sed -i '/^nvidia$/d' "${ARIAOS_TEST_STATE:?}/modules"
        fi
        ;;
      *)
        if [[ ${1:-} == -r ]]; then
          exit 0
        fi
        grep -qx "$1" "${ARIAOS_TEST_STATE:?}/modules" 2>/dev/null || \
          echo "$1" >> "${ARIAOS_TEST_STATE:?}/modules"
        ;;
    esac
    ;;
  mv)
    if [[ ${ARIAOS_TEST_SCENARIO:-} == restore_rollback && ${2:-} == /var/home ]]; then
      marker=${ARIAOS_TEST_STATE:?}/activation-attempted
      if [[ ! -e $marker ]]; then
        : > "$marker"
        exit 1
      fi
    fi
    exit 0
    ;;
  nvidia-ctk)
    exit 0
    ;;
  nvidia-smi)
    printf 'GPU 0: Test NVIDIA GPU\n'
    ;;
  pv)
    for argument in "$@"; do
      if [[ -f $argument ]]; then
        cat "$argument"
        exit 0
      fi
    done
    cat
    ;;
  stat)
    printf '64\n'
    ;;
  sudo)
    "$@"
    ;;
  systemctl)
    case " $* " in
      *" is-active ariaos-egpu.service "*)
        [[ -e ${ARIAOS_TEST_STATE:?}/egpu-active ]]
        ;;
      *" start ariaos-egpu.service "*)
        : > "${ARIAOS_TEST_STATE:?}/egpu-active"
        ;;
      *" stop ariaos-egpu.service "*)
        rm -f "${ARIAOS_TEST_STATE:?}/egpu-active"
        ;;
    esac
    ;;
  tuned-adm)
    if [[ ${1:-} == active ]]; then
      printf 'Current active profile: balanced-battery\n'
    fi
    ;;
  zstd)
    output=
    while (( $# > 0 )); do
      if [[ $1 == -o ]]; then
        output=$2
        break
      fi
      shift
    done
    cat >/dev/null
    : > "${output:?}"
    exit 1
    ;;
  zstdcat)
    if [[ ${ARIAOS_TEST_SCENARIO:-} == restore_invalid ]]; then
      exit 1
    fi
    cat
    ;;
esac
